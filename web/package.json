{
  "name": "xszs-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "python3 ../scripts/build-leptos.py build --debug && vite --host 0.0.0.0",
    "typecheck": "npm run check:leptos",
    "test:unit": "npm run test:leptos",
    "check:xcss": "node tests/xcss-baseline.test.mjs",
    "build": "npm run check:xcss && python3 ../scripts/build-leptos.py build && vite build",
    "test:browser": "npm run build && node tests/browser-acceptance.mjs",
    "build:server": "xcss-build-server --config ../xcss-web-build.json --mode development",
    "build:leptos": "npm run build",
    "check:leptos": "python3 ../scripts/build-leptos.py check",
    "test:leptos": "python3 ../scripts/build-leptos.py test",
    "test:browser:leptos": "npm run test:browser"
  },
  "dependencies": {
    "@xcss/web": "https://github.com/isarmg/xcss/releases/download/v1.0.0/xcss-web-1.0.0.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "vite": "8.3.3"
  }
}
